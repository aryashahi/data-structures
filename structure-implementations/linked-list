                if self.size!=0:
                    node.next = self.head
                    self.head = node
                    
                else:
                    self.head = node
                self.size = self.size + 1 
                return True

            else:
                while temp.next != None:
                    if (count + 1 ) == index:
                        node.next =temp.next 
                        temp.next = node
                        self.size = self.size + 1 
                        return True
                    count = count+1
                    temp = temp.next
        else:
            return False           
                    
