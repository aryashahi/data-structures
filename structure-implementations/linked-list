#Linked list implementation
class NewNode:
    def __init__(self, value):
        self.value = value
        self.next = None

class LinkedList:
    def __init__(self):
        self.head = None
        self.size = 0

    def add(self, value):
        node = NewNode(value)
        temp = self.head

        if self.head is None:
            self.head = node
            self.size = self.size + 1 
            return True

        while temp.next is not None:
            temp = temp.next
        
        temp.next = node
        self.size = self.size + 1 
        return True

    def add_at_index(self, index,value):
