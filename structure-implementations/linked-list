    def remove_value(self, value):

        if self.head is None:
            return
        if self.head.value == value:
            self.head = self.head.next
            self.size = self.size - 1 
            return
        
        curr =self.head.next
        prev = self.head
        
        while (curr != None):
            if curr.value == value:
                prev.next = curr.next
                self.size = self.size - 1 
                return
            prev = curr
            curr = curr.next

